\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Hyperparameter tuning time comparison across different models, metrics, and strategies. BO: Bayesian optimization, unsup.: unsupervised SAHI tuning, sup.: supervised SAHI tuning.}}{24}{table.5}\protected@file@percent }
