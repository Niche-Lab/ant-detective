	number = {4},
	urldate = {2024-10-08},
	journal = {Insects},
	author = {Hong, Suk-Ju and Nam, Il and Kim, Sang-Yeon and Kim, Eungchan and Lee, Chang-Hyup and Ahn, Sebeom and Park, Il-Kwon and Kim, Ghiseok},
	month = apr,
