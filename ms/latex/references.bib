	pages = {342},
	file = {Full Text PDF:/Users/niche/Zotero/storage/SMCQRQ5F/Hong et al. - 2021 - Automatic Pest Counting from Pheromone Trap Images Using Deep Learning Object Detectors for Matsucoc.pdf:application/pdf},
