\newlabel{fig:s2_vis}{{6}{20}{Comparison of detection results between the original image and SAHI-aid inference results. The SAHI-aid inference was conducted by YOLO11n with parameters of divider number = 4 and overlap ratio = 0. (a) The original scale (b) Three examples in rows showing zoomed-in views of the original image. The detected ants are highlighted with blue bounding boxes}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Model performance on the \textit  {Dense} subset with different models, calibration strategies, and search approaches. The top panel shows the mAP@0.5 performance of YOLO11n, YOLO11m, and RT-DETR-L models under different strategies and search approaches. The letter in black indicates the Tukey HSD test result, where different letters indicate significant differences between search approaches. While the letter in white font and purple background indicates the Tukey HSD test result between calibration strategies with grid search as the search approach of optimal parameters. The bottom panel compares the computational cost of different search approaches in terms of hyperparameter tuning time. The black font indicates the Tukey HSD test results between search approaches.}}{21}{figure.7}\protected@file@percent }
\newlabel{fig:s2_results}{{7}{21}{Model performance on the \textit {Dense} subset with different models, calibration strategies, and search approaches. The top panel shows the mAP@0.5 performance of YOLO11n, YOLO11m, and RT-DETR-L models under different strategies and search approaches. The letter in black indicates the Tukey HSD test result, where different letters indicate significant differences between search approaches. While the letter in white font and purple background indicates the Tukey HSD test result between calibration strategies with grid search as the search approach of optimal parameters. The bottom panel compares the computational cost of different search approaches in terms of hyperparameter tuning time. The black font indicates the Tukey HSD test results between search approaches}{figure.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Model performance comparison on the subset \textit  {Dense} across different calibration strategies and search approach. FT: finetuning with target images, unsup.: unsupervised SAHI tuning, sup.: supervised SAHI tuning. BO: Bayesian optimization.}}{22}{table.3}\protected@file@percent }
\newlabel{tab:s2_performance}{{3}{22}{Model performance comparison on the subset \textit {Dense} across different calibration strategies and search approach. FT: finetuning with target images, unsup.: unsupervised SAHI tuning, sup.: supervised SAHI tuning. BO: Bayesian optimization}{table.3}{}}
